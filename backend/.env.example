# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Port the HTTP/socket server listens on.
PORT=5000

# REQUIRED. Secret used to sign and verify JWTs. There is no default — the
# server refuses to start without it. Use a long, random string.
JWT_KEY=change-me-to-a-long-random-secret

# MongoDB connection (the database name is appended via MONGO_DB_NAME).
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DB_NAME=chat

# Firebase Cloud Messaging (optional — push notifications are disabled if unset).
# Either point to a service account key file...
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# ...or inline the JSON:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
